# Caddy: HTTPS automático (Let's Encrypt), cabeceras de seguridad, SPA estática y proxy a la API.
#
# DOMINIO=expedientes.hospital.co  -> certificado público automático.
# DOMINIO=localhost                -> certificado de una CA interna de Caddy (pruebas locales).
# DOMINIO=http://localhost         -> solo HTTP, sin TLS (pruebas locales detrás de otro proxy).
{
	email {$ACME_EMAIL}
	# Detrás de un túnel o proxy privado (p. ej. Cloudflare Tunnel con cloudflared en el mismo equipo) la IP real
	# del visitante viene en Cf-Connecting-Ip. Solo se confía en esa cabecera si la conexión llega desde un rango
	# privado; una conexión directa desde internet (VPS con Caddy de cara al público) la ignora.
	servers {
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

{$DOMINIO} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		# 'wasm-unsafe-eval': PDF.js usa WebAssembly para decodificar imágenes.
		# worker-src blob:/self: el worker de PDF.js. style-src 'unsafe-inline': atributos style de React.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Nada operativo se publica: ni métricas ni salud ni documentación.
	@internos path /metrics /health /docs /docs/* /redoc /openapi.json
	handle @internos {
		respond 404
	}

	# Rastreo de errores de la web: solo la ruta de recepción va a GlitchTip, y sin nada que identifique a la
	# persona (cookies, sesión, página, navegador, idioma ni IP). El panel de GlitchTip no se publica.
	@errores path_regexp ^/api/[0-9]+/envelope/$
	handle @errores {
		@apagado expression `"{$ERRORES_UPSTREAM}" == ""`
		respond @apagado 404
		reverse_proxy {$ERRORES_UPSTREAM:127.0.0.1:1} {
			header_up -Cookie
			header_up -Authorization
			header_up -Referer
			header_up -User-Agent
			header_up -Accept-Language
			header_up -Cf-Connecting-Ip
			header_up -X-Forwarded-For
		}
	}

	handle /api/* {
		# Un pliego puede pesar cientos de MB (MAX_UPLOAD_MB en la API Java es el límite real).
		request_body {
			max_size 320MB
		}
		reverse_proxy api:8080 {
			# Caddy pone en X-Forwarded-For la IP real del cliente (descarta la que envíe el cliente).
			header_up X-Request-ID {http.request.uuid}
			# Una sola IP (la del visitante), sin acumular saltos: la API toma la última de X-Forwarded-For.
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}

	# App instalable: si llega un «Compartir» antes de que el service worker esté activo (lo atiende él), se
	# redirige a la página que pide iniciar sesión; el archivo de ese envío no se guarda en el servidor.
	@compartir {
		method POST
		path /compartir
	}
	handle @compartir {
		redir /compartir 303
	}

	handle {
		root * /srv
		@indice path /index.html /
		header @indice Cache-Control "no-cache"
		# El service worker y el manifiesto deben revisarse siempre: así las versiones nuevas llegan enseguida.
		@pwa path /sw.js /manifest.webmanifest /registerSW.js
		header @pwa Cache-Control "no-cache"
		@estaticos path /assets/*
		header @estaticos Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
