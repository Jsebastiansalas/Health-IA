# Agente de IA (Python). Copiar a .env y ajustar. Nunca versionar .env.
# Con docker compose, DATABASE_URL, REDIS_URL, EPHEMERAL_DIR e INTERNAL_TOKEN los fija infra/docker-compose.yml;
# este archivo aporta sobre todo las keys de IA, que SOLO lee el agente.
#
# La identidad de los usuarios (JWT, roles) la gestiona la API Java (api-java/): aquí no hay JWT_SECRET.

# Puerto 5434 en el host para no chocar con otros Postgres locales (ver infra/docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://medtender:medtender@localhost:5434/medtender
REDIS_URL=redis://localhost:6380/0

# Secreto compartido con la API Java (X-Internal-Token). Debe coincidir con INTERNAL_TOKEN de infra/.env.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_TOKEN=

# Directorio efímero compartido con la API Java (ella escribe el PDF, el agente lo lee y lo borra)
# EPHEMERAL_DIR=           # por defecto <temp del sistema>/medtender-ephemeral
PURGA_DIFERIDA_MINUTOS=60
PROCESAMIENTO_TIMEOUT_MINUTOS=360
HUERFANO_MINUTOS=10
BARRIDO_INTERVALO_S=300

# Cola y worker
COLA_BACKEND=arq           # "ninguna" deja los documentos en EN_COLA

# Embeddings. Modelos: gemini-embedding-001 (1536) | text-embedding-3-small (1536) | bge-m3 (1024, Ollama local)
EMBEDDING_MODEL_DEFAULT=gemini-embedding-001
# AVISO: en el nivel gratuito de la API de Gemini, Google puede usar el contenido enviado para
# mejorar sus productos. Con documentos confidenciales use el nivel de pago o bge-m3 local.
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434
OCR_VERSION_ACTUAL=tesseract-5.5-v1

# Motor RAG
# Sin definirlos, cada proveedor usa los suyos: gemini-2.5-flash (API de AI Studio) o gemini-3.8-flash (Vertex).
# LLM_MODEL=gemini-2.5-flash
# RAG_HNSW_ITERATIVE=strict_order   # orden exacto por distancia (lo que necesita RRF)
# LLM_MODELOS_RESPALDO=["gemini-3.8-flash"]

# IA de producción. Para Vertex en el Docker local usa infra/docker-compose.vertex.yml.
# IA_PROVEEDOR=gemini_api            # o vertex
# LLM_RESPALDO_PROVEEDOR=claude      # responde si Gemini falla
# ANTHROPIC_API_KEY=
# IA_TOPE_DIARIO_USD=2               # al llegar, la IA no responde hasta el otro día
# CRONOLOGIA_AL_INDEXAR=true         # leer cada documento al subirlo (cuentas personales)

# Operación y endurecimiento
# ENTORNO=produccion        # exige configuración segura al arrancar y desactiva /docs
# LOG_JSON=true             # en producción siempre JSON
# METRICS_TOKEN=            # Bearer para /metrics; sin token y en producción no existe
# Pool de conexiones por proceso: máximo = DB_POOL_SIZE + DB_MAX_OVERFLOW
# DB_POOL_SIZE=15  DB_MAX_OVERFLOW=15  DB_POOL_TIMEOUT_S=10
