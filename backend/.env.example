# Copiar a .env y ajustar. Nunca versionar .env.
# Puerto 5434 en el host para no chocar con otros Postgres locales (ver infra/docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://medtender:medtender@localhost:5434/medtender

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
ALLOW_TENANT_SIGNUP=true
CORS_ORIGINS=["http://localhost:5173"]

# Ingesta efímera (Sprint 2)
MAX_UPLOAD_MB=300
# EPHEMERAL_DIR=           # por defecto <temp del sistema>/medtender-ephemeral
ANTIVIRUS_BACKEND=clamav   # "noop" solo en desarrollo sin ClamAV (no escanea)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
PURGA_DIFERIDA_MINUTOS=60
PROCESAMIENTO_TIMEOUT_MINUTOS=360
HUERFANO_MINUTOS=10
BARRIDO_INTERVALO_S=300

# Cola y worker (Sprint 3)
REDIS_URL=redis://localhost:6380/0
COLA_BACKEND=arq           # "ninguna" deja los documentos en EN_COLA

# Embeddings (Sprint 4). Modelo con el que nacen los expedientes nuevos:
#   gemini-embedding-001 (1536) | text-embedding-3-small (1536) | bge-m3 (1024, Ollama local)
EMBEDDING_MODEL_DEFAULT=gemini-embedding-001
# AVISO: en el nivel gratuito de la API de Gemini, Google puede usar el contenido enviado para
# mejorar sus productos. Con documentos confidenciales use el nivel de pago o bge-m3 local.
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434
OCR_VERSION_ACTUAL=tesseract-5.5-v1

# Motor RAG (Sprint 5)
LLM_MODEL=gemini-2.5-flash
# RAG_HNSW_ITERATIVE=strict_order   # orden exacto por distancia (lo que necesita RRF)
# LLM_MODELOS_RESPALDO=["gemini-3.8-flash"]

# Operación y endurecimiento (Sprint 6)
# ENTORNO=produccion        # exige configuración segura al arrancar y desactiva /docs
# LOG_JSON=true             # en producción siempre JSON
# CONFIAR_PROXY=true        # solo detrás de Caddy: la IP real es la última de X-Forwarded-For
# METRICS_TOKEN=            # Bearer para /metrics; sin token y en producción no existe
RATE_LIMIT_HABILITADO=true
RATE_LIMIT_BACKEND=redis    # "memoria" solo para pruebas (no se comparte entre procesos)
# Límites (valores por defecto): ver README, sección "Límites de peticiones"
# RL_GENERAL_IP_MIN=600  RL_LOGIN_IP_MIN=20  RL_LOGIN_FALLOS_PAR=5  RL_CONSULTA_USUARIO_MIN=20
# Pool de conexiones por proceso: máximo = DB_POOL_SIZE + DB_MAX_OVERFLOW
# DB_POOL_SIZE=15  DB_MAX_OVERFLOW=15  DB_POOL_TIMEOUT_S=10
