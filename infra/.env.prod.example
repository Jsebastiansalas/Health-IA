# Copiar a .env.prod (NUNCA versionarlo) y completar. Generar secretos con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Use solo caracteres hexadecimales/alfanuméricos: van dentro de URLs de conexión.

DOMINIO=expedientes.mi-hospital.co
ACME_EMAIL=ti@mi-hospital.co

# Propietario del esquema: solo lo usan las migraciones y los respaldos.
POSTGRES_PASSWORD=
# Rol `medtender_app` con el que operan la API y el agente. Sin privilegios de superusuario: es el que
# sujeta cada consulta al aislamiento por tenant (RLS). Distinto de POSTGRES_PASSWORD.
APP_DB_PASSWORD=
REDIS_PASSWORD=
# Firma de los tokens de usuario (solo la API Java).
JWT_SECRET=
# Clave para cifrar los secretos de la verificación en dos pasos (32 bytes en base64): openssl rand -base64 32
# No la cambies después: los secretos ya guardados dejarían de poder leerse.
CIFRADO_CLAVE=
# Secreto compartido entre la API Java y el agente de IA (X-Internal-Token). Distinto de JWT_SECRET.
INTERNAL_TOKEN=
# Token para que Prometheus lea /metrics (API y agente). Se consulta desde la red interna: /metrics no se publica.
METRICS_TOKEN=

# Los respaldos contienen el texto extraído de los documentos: se cifran con esta frase.
# Guárdela en un gestor de secretos; sin ella las copias no se pueden restaurar.
BACKUP_PASSPHRASE=
BACKUP_RETENCION_DIAS=14
BACKUP_INTERVALO_HORAS=24
# Carpeta del servidor para los respaldos (si se deja vacío usa un volumen de Docker).
# BACKUP_DIR=/srv/medtender/respaldos

# Proveedor de IA (solo lo usa el agente Python). En producción es obligatorio Gemini en Google Cloud (Vertex AI): no usa los
# datos para entrenar. La API gratuita de AI Studio (GEMINI_API_KEY) queda prohibida y el agente no arranca con ella.
VERTEX_PROYECTO=
# Región del modelo: global, us o eu para gemini-3.8-flash (no está en us-central1). Con «global» Google decide dónde se
# procesa. Los embeddings van aparte.
VERTEX_REGION=global
VERTEX_REGION_EMBEDDINGS=us-central1
# Ruta en el servidor al JSON de la cuenta de servicio (rol «Agent Platform User»). Nunca en el repositorio. El agente corre
# con el usuario 1001 y tiene que poder leerlo: sudo chown 1001 vertex.json && sudo chmod 600 vertex.json
VERTEX_CREDENCIALES_ARCHIVO=/srv/medtender/secretos/vertex.json
# Respaldo si Vertex falla o se satura (vacío para no usarlo) y su clave.
LLM_RESPALDO_PROVEEDOR=claude
ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-opus-5-5
# Tope del gasto estimado en IA por día, en dólares. Al llegar, la IA deja de responder hasta el otro día.
IA_TOPE_DIARIO_USD=10
OPENAI_API_KEY=
EMBEDDING_MODEL_DEFAULT=gemini-embedding-001
LLM_MODEL=gemini-3.8-flash
MAX_UPLOAD_MB=300

# Correo SMTP (obligatorio en producción porque CORREO_VERIFICACION_OBLIGATORIA=true):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Solo para pruebas locales (puertos distintos de 80/443):
# HTTP_PORT=8088
# HTTPS_PORT=8443
