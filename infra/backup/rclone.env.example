# Credenciales del destino de las copias fuera del equipo. Cópialo a infra/backup/rclone.env (Git lo ignora),
# rellena UNA de las dos opciones y en infra/.env pon BACKUP_REMOTO=remoto:nombre-del-bucket/medtender
# Usa una clave limitada a ese bucket. Las copias llegan ya cifradas con BACKUP_PASSPHRASE.

# --- Opción A: Backblaze B2 ---
# RCLONE_CONFIG_REMOTO_TYPE=b2
# RCLONE_CONFIG_REMOTO_ACCOUNT=
# RCLONE_CONFIG_REMOTO_KEY=

# --- Opción B: Cloudflare R2 ---
# RCLONE_CONFIG_REMOTO_TYPE=s3
# RCLONE_CONFIG_REMOTO_PROVIDER=Cloudflare
# RCLONE_CONFIG_REMOTO_ACCESS_KEY_ID=
# RCLONE_CONFIG_REMOTO_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_REMOTO_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
