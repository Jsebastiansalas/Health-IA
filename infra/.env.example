# Desarrollo local: copiar a infra/.env (git lo ignora). Compose lo lee solo.
#   JWT_SECRET      firma de los tokens de usuario (lo usa la API Java). >= 32 caracteres.
#   INTERNAL_TOKEN  secreto compartido entre la API Java y el agente Python (X-Internal-Token).
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
INTERNAL_TOKEN=
# Las keys de IA (GEMINI_API_KEY...) van en agente/.env, que SOLO lee el agente.

# Correo de verificación (Brevo u otro SMTP). Déjalo vacío para no enviar correos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CORREO_REMITENTE=
CORREO_VERIFICACION_OBLIGATORIA=false

# Con un túnel o proxy delante (beta cerrada): true. CORREO_BASE_URL = dirección pública de la web.
CONFIAR_PROXY=false
CORREO_BASE_URL=http://localhost:8088

# Cifra en la base las preguntas y respuestas (API y agente). 32 bytes en base64. Vacía: sin cifrar.
# Guárdala aparte: si se pierde, el historial cifrado no se recupera.
DATOS_CLAVE=

# Notificaciones push de los recordatorios. Generar el par una vez, desde agente/:
#   uv run python ../infra/scripts/generar_vapid.py
# La privada es secreta. Cambiarlas obliga a cada persona a activar los avisos de nuevo.
PUSH_CLAVE_PUBLICA=
PUSH_CLAVE_PRIVADA=
# Un correo (mailto:...) o la dirección del sitio, para que el servicio de push pueda avisar de un problema.
PUSH_CONTACTO=
